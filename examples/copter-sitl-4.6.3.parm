# Boot parameters for a SITL 5 inch quad on 6S, Copter 4.6.3, built from
# ArduPilot's freestyle SITL model.
#
# The pair of copter-sitl-4.7.1.parm: the same flight profile and the same
# logging set, so a log from each can be compared with only the firmware
# different. The two files differ only in the four names in these files that
# 4.7 renames, which are written here as 4.6.3 has them:
#   ANGLE_MAX        3000 cdeg  (4.7: ATC_ANGLE_MAX 30 deg)
#   WPNAV_ACCEL      250 cm/s/s (4.7: WP_ACC 2.5 m/s/s)
#   WPNAV_JERK       2          (4.7: WP_JERK 2)
#   SIM_GPS_NUMSATS  16         (4.7: SIM_GPS1_NUMSATS 16)
# Every other name is identical at both versions, INS_HNTCH_* and
# INS_LOG_BAT_* included.
#
# Logging is the batch sampler with the harmonic notch on (not the raw gyro
# stream), which keeps a 125 s flight near 30 MB.
#
# Boot SITL with this file loaded, then check it took. Run from the repository
# root; sitl.sh runs from the ArduPilot tree, so --add-param-file needs an
# absolute path (the README has the AP_TREES setting):
#   AP_TREES=/path/to/trees ./sitl.sh 4.6.3 ArduCopter --no-mavproxy -f freestyle -w --add-param-file="$PWD/examples/copter-sitl-4.6.3.parm"
#   python3 sitl-copter-fixture.py --check-params examples/copter-sitl-4.6.3.parm
# --check-params reads every name back off the vehicle before arming.
ANGLE_MAX        3000
BATT_CAPACITY    5000
BATT_CRT_VOLT    0
BATT_FS_LOW_ACT  0
BATT_FS_VOLTSRC  1
BATT_LOW_TIMER   10
BATT_LOW_VOLT    19.2
EK3_IMU_MASK     1
FS_GCS_ENABLE    0
FS_THR_ENABLE    1
INS_HNTC2_ENABLE 0
INS_HNTCH_ATT    40
INS_HNTCH_BW     75
INS_HNTCH_ENABLE 1
INS_HNTCH_FREQ   150
INS_HNTCH_HMNCS  3
INS_HNTCH_MODE   3
INS_HNTCH_OPTS   0
INS_HNTCH_REF    1
INS_LOG_BAT_CNT  1024
INS_LOG_BAT_LGCT 32
INS_LOG_BAT_LGIN 20
INS_LOG_BAT_MASK 1
INS_LOG_BAT_OPT  4
INS_RAW_LOG_OPT  0
LOG_BITMASK      136957
LOG_DISARMED     0
LOG_FILE_RATEMAX 0
LOIT_ANG_MAX     20
MOT_HOVER_LEARN  1
MOT_SPIN_ARM     0.03
MOT_SPIN_MIN     0.05
MOT_THST_HOVER   0.15
RSSI_TYPE        0
SERIAL5_PROTOCOL 16
SIM_ACC1_RND     3
SIM_BATT_VOLTAGE 25.2
SIM_ESC_TELEM    1
SIM_GPS_NUMSATS  16
SIM_GYR1_RND     10
SIM_VIB_MOT_HMNC 1
SIM_VIB_MOT_MAX  560
SIM_VIB_MOT_MULT 1
WPNAV_ACCEL      250
WPNAV_JERK       2
